# Depth of Field
option.DOF_ENABLED=Depth of Field
option.DOF_ENABLED.comment=Enables thin lens depth of field simulation. Out-of-focus areas will appear blurred based on camera settings.

option.DOF_AUTOFOCUS=Autofocus
option.DOF_AUTOFOCUS.comment=Automatically focuses on the object at the center of the screen. When disabled, the manual focus distance is used instead.

option.DOF_FOCAL_LENGTH=Focal Length
option.DOF_FOCAL_LENGTH.comment=Camera lens focal length. Longer focal lengths produce a narrower field of view and stronger background blur. Common values: 24mm wide-angle, 50mm normal, 85mm portrait, 200mm telephoto.
suffix.DOF_FOCAL_LENGTH=mm

option.DOF_FSTOP=Aperture
option.DOF_FSTOP.comment=Lens f-stop number. Lower values mean a wider aperture, producing shallower depth of field and more bokeh blur. Higher values keep more of the scene in focus.
prefix.DOF_FSTOP=f/

option.DOF_FOCUS_DISTANCE=Focus Distance
option.DOF_FOCUS_DISTANCE.comment=Manual focus distance in blocks. Only used when autofocus is disabled.
suffix.DOF_FOCUS_DISTANCE=m

option.DOF_SENSOR_WIDTH=Sensor Size
option.DOF_SENSOR_WIDTH.comment=Camera sensor width. Larger sensors produce shallower depth of field at equivalent framing. 23.5mm = APS-C, 36mm = Full Frame, 44mm = Medium Format.
suffix.DOF_SENSOR_WIDTH=mm
value.DOF_SENSOR_WIDTH.23.5=APS-C (23.5)
value.DOF_SENSOR_WIDTH.28.7=APS-H (28.7)
value.DOF_SENSOR_WIDTH.36.0=Full Frame (36)
value.DOF_SENSOR_WIDTH.44.0=Medium Format (44)
value.DOF_SENSOR_WIDTH.53.0=Large Format (53)

option.DOF_BLADES=Aperture Blades
option.DOF_BLADES.comment=Number of aperture blades. Controls the shape of out-of-focus highlights (bokeh). 0 = perfectly circular, 5-7 = common in real lenses, higher values approach a circle.
value.DOF_BLADES.0=Circle

# Scene Capacity
option.MAX_QUAD_COUNT=VRAM Usage
option.MAX_QUAD_COUNT.comment=Approximate VRAM allocated for scene geometry, BVH, and sort buffers. Higher values support more quads at a higher memory cost.
value.MAX_QUAD_COUNT.1048576=157 MiB
value.MAX_QUAD_COUNT.2097152=314 MiB
value.MAX_QUAD_COUNT.4194304=628 MiB
value.MAX_QUAD_COUNT.8388608=1.23 GiB
value.MAX_QUAD_COUNT.16777216=2.45 GiB
value.MAX_QUAD_COUNT.33554432=4.91 GiB

option.GLASS_CAUSTICS=Refractive Caustics
option.GLASS_CAUSTICS.comment=Enables guided sunlight estimators for refractive caustics and low-roughness specular highlights at extra ray tracing cost.

option.GLASS_CAUSTIC_DISPERSION=Caustic Dispersion
option.GLASS_CAUSTIC_DISPERSION.comment=Separates refractive glass and water caustics by wavelength. Produces colored caustics with additional color noise.

option.GLASS_CAUSTIC_SAMPLES=Refractive Caustic Samples
option.GLASS_CAUSTIC_SAMPLES.comment=Extra guided sunlight samples per shaded hit. More samples reduce refractive caustic and specular highlight noise but increase render time.

option.GLASS_CAUSTIC_CONE_DEGREES=Refractive Caustic Search
option.GLASS_CAUSTIC_CONE_DEGREES.comment=Angular search cone around the sun for refracted caustic rays. Smaller values are cleaner; larger values catch stronger bending.
suffix.GLASS_CAUSTIC_CONE_DEGREES=deg

option.GLASS_CAUSTIC_FILTER=Refractive Caustic Filter
option.GLASS_CAUSTIC_FILTER.comment=Broadens the effective sun disk used by refractive caustics. Higher values reduce noise and fireflies but soften caustic detail.

option.GLASS_CAUSTIC_CLAMP=Refractive Caustic Clamp
option.GLASS_CAUSTIC_CLAMP.comment=Limits unusually bright caustic samples. Lower values reduce fireflies but can dim sharp caustics. 0 disables the limit.

option.MODE=Mode
value.MODE.1=Reference PT
value.MODE.2=BVH debug
value.MODE.3=Skip
value.MODE.4=Simple RT

option.BVH_WIDTH=BVH Width
option.BVH_WIDTH.comment=BVH2 skips wide conversion. BVH4 trades additional build time and memory for four-child traversal.
value.BVH_WIDTH.2=BVH2
value.BVH_WIDTH.4=BVH4

option.BVH_STACK_MODE=BVH Stack
option.BVH_STACK_MODE.comment=Controls where ray traversal stores its stack.
value.BVH_STACK_MODE.0=Shared memory
value.BVH_STACK_MODE.1=Image
value.BVH_STACK_MODE.2=Local memory

option.HPLOC_SEARCH_RADIUS_SHIFT=BVH Build Search
option.HPLOC_SEARCH_RADIUS_SHIFT.comment=Neighbor search radius. Auto uses one neighbor for Simple RT and two for path tracing. Larger searches can improve traversal at a higher build cost.
value.HPLOC_SEARCH_RADIUS_SHIFT.-1=Auto
value.HPLOC_SEARCH_RADIUS_SHIFT.0=1
value.HPLOC_SEARCH_RADIUS_SHIFT.1=2
value.HPLOC_SEARCH_RADIUS_SHIFT.2=4
value.HPLOC_SEARCH_RADIUS_SHIFT.3=8

screen.CAPTURE=Geometry Capture
screen.PT_OPTIONS=Path Tracing
screen.DEBUG=Debug

option.ENABLE_GBUFFER_CAPTURE=G-buffer Capture
option.ENABLE_GBUFFER_CAPTURE.comment=Adds geometry from G-buffer passes to the ray-traced scene.

option.SHADOW_CAPTURE_DISTANCE=Capture Distance
option.SHADOW_CAPTURE_DISTANCE.comment=Maximum camera-relative capture distance in blocks. Higher values capture more geometry and increase BVH build cost.
value.SHADOW_CAPTURE_DISTANCE.128=128 blocks
value.SHADOW_CAPTURE_DISTANCE.256=256 blocks
value.SHADOW_CAPTURE_DISTANCE.512=512 blocks
value.SHADOW_CAPTURE_DISTANCE.1024=1024 blocks

option.ALPHA_TEST=Alpha Testing
option.ALPHA_TEST.comment=Uses captured texture alpha to skip transparent texels during ray tracing.

option.ENTITY_TEXTURES=Entity Textures
option.ENTITY_TEXTURES.comment=Captures and samples entity albedo textures for path tracing; uses GPU memory.

option.ENTITY_PBR=Entity PBR
option.ENTITY_PBR.comment=Uses captured entity normal and specular maps. Requires Entity Textures.

option.ENABLE_QUAD_VALIDATION=Quad Validation
option.ENABLE_QUAD_VALIDATION.comment=Displays captured-quad validation errors in the debug overlay.

option.ENABLE_SUBGROUP_VALIDATION=Subgroup Validation
option.ENABLE_SUBGROUP_VALIDATION.comment=Checks full vertex quads, consecutive vertex IDs, shared allocation IDs, and slots 0-3. Shows passing counts in the debug overlay.

option.ENABLE_SORT_VALIDATION=Sort Validation
option.ENABLE_SORT_VALIDATION.comment=Checks BVH sorting and leaf pairing, then displays any errors in the debug overlay.

option.ENTITY_TEXTURES_DEBUG=Entity Texture Debug
option.ENTITY_TEXTURES_DEBUG.comment=Displays entity texture table and atlas usage in the debug overlay.

option.ENABLE_DEBUG_OVERLAY=Debug Overlay
option.ENABLE_DEBUG_OVERLAY.comment=Displays scene capacity and bounds, plus any enabled validation details.
